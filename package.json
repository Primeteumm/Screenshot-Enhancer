{
  "name": "screenshot-enhancer",
  "version": "0.2.0",
  "description": "macOS-style screenshot preview for Windows: a floating, drag-and-drop thumbnail for every screenshot, with OCR.",
  "main": "src/main/index.js",
  "author": "Enes Aydin",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "icons": "node scripts/generate-icons.js",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "chokidar": "^3.6.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.enesaydin.screenshotenhancer",
    "productName": "Screenshot Enhancer",
    "files": [
      "src/**/*",
      "assets/**/*",
      "scripts/ocr.ps1",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Screenshot Enhancer"
    },
    "asarUnpack": [
      "scripts/ocr.ps1"
    ],
    "extraMetadata": {
      "description": "Screenshot Enhancer"
    }
  }
}
